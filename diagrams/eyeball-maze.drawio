                </UserObject>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% Enumerations (unchanged)\n    class Direction {\n        &lt;&lt;enumeration&gt;&gt;\n        UP DOWN LEFT RIGHT\n    }\n    class Color {\n        &lt;&lt;enumeration&gt;&gt;\n        BLUE RED YELLOW GREEN BLANK PURPLE\n    }\n    class Shape {\n        &lt;&lt;enumeration&gt;&gt;\n        DIAMOND CROSS STAR FLOWER BLANK LIGHTNING\n    }\n    class Message {\n        &lt;&lt;enumeration&gt;&gt;\n        OK DIFFERENT_SHAPE_OR_COLOR BACKWARDS_MOVE MOVING_OVER_BLANK MOVING_DIAGONALLY\n    }\n    class ErrorCode {\n        &lt;&lt;enumeration&gt;&gt;\n        INDEX_OUT_OF_BOUNDS SQUARE_NOT_FOUND INVALID_MOVE\n    }\n\n    %% Core Domain\n    class Position {\n        #row: int\n        #column: int\n        +Position(row: int, column: int)\n        +getRow(): int\n        +getColumn(): int\n    }\n\n    class Square {\n        &lt;&lt;abstract&gt;&gt;\n        +isGoal: boolean\n        #color: Color\n        #shape: Shape\n    }\n    class PlayableSquare {\n        +PlayableSquare()\n        +PlayableSquare(color: Color, shape: Shape)\n        +setAsGoal(): void\n    }\n    class BlankSquare {\n    }\n\n    class EyeBall {\n        #currentPosition: Position\n        #currentDirection: Direction\n        +EyeBall(y: int, x: int, dir: Direction)\n        +getYPosition(): int\n        +getXPosition(): int\n        +getDirection(): Direction\n        +updatePosition(row: int, col: int): void\n        +getNewFacingDirection(targetY: int, targetX: int): Direction\n    }\n\n    class GameLevel {\n        #levelNumber: int\n        #levelWidth: int\n        #levelHeight: int\n        +totalGoalCount: int\n        +completedGoalCount: int\n        +GameLevel(number: int, height: int, width: int)\n        +getWidth(): int\n        +getHeight(): int\n    }\n\n    %% Board / Grid\n    class Board {\n        -squares: Map~String, Square~\n        +addSquare(square: Square, row: int, col: int): void\n        +getSquareAt(row: int, col: int): Square\n        +getColorAt(row: int, col: int): Color\n        +getShapeAt(row: int, col: int): Shape\n        +isValidCoordinate(row: int, col: int): boolean\n        +hasGoalAt(row: int, col: int): boolean\n        +addGoal(row: int, col: int): void\n        +getGoalCount(): int\n        +getCompletedGoalCount(): int\n        +updateGoalSquare(): void\n    }\n\n    %% Managers (extracted responsibilities)\n    class LevelManager {\n        -levels: List~GameLevel~\n        -currentLevel: GameLevel\n        -currentBoard: Board\n        +addLevel(height: int, width: int): void\n        +setLevel(levelNum: int): void\n        +getLevelCount(): int\n        +getCurrentLevelWidth(): int\n        +getCurrentLevelHeight(): int\n        +getCurrentBoard(): Board\n    }\n\n    class GoalManager {\n        +addGoal(row: int, col: int): void\n        +getGoalCount(): int\n        +hasGoalAt(row: int, col: int): boolean\n        +getCompletedGoalCount(): int\n        +updateCompletedGoals(): void\n    }\n\n    %% Movement\n    class IMoveStrategy {\n        &lt;&lt;interface&gt;&gt;\n        +canMoveTo(board: Board, fromRow: int, fromCol: int, toRow: int, toCol: int): boolean\n        +getMoveMessage(...): Message\n        +isDirectionOK(...): boolean\n        +hasBlankFreePath(...): boolean\n    }\n\n    class StandardMoveStrategy {\n        +canMoveTo(...): boolean\n        ...\n    }\n\n    class MovementEngine {\n        -strategy: IMoveStrategy\n        +setStrategy(strategy: IMoveStrategy): void\n        +canMoveTo(...): boolean\n        +moveTo(eyeball: EyeBall, board: Board, row: int, col: int): Message\n        +messageIfMovingTo(...): Message\n    }\n\n    %% Main Orchestrator (Facade)\n    class Game {\n        -levelManager: LevelManager\n        -goalManager: GoalManager\n        -movementEngine: MovementEngine\n        -eyeball: EyeBall\n        -logger: Logger\n        +Game()\n        +addLevel(height: int, width: int): void\n        +setLevel(newLevel: int): void\n        +addSquare(square: Square, row: int, col: int): void\n        +addEyeball(y: int, x: int, dir: Direction): void\n        +moveTo(row: int, col: int): void\n        +getCompletedGoalCount(): int\n        +getColorAt(row: int, col: int): Color\n        +getShapeAt(row: int, col: int): Shape\n        ...\n    }\n\n    %% Relationships\n    Game \&quot;1\&quot; --&gt; \&quot;1\&quot; LevelManager\n    Game \&quot;1\&quot; --&gt; \&quot;1\&quot; GoalManager\n    Game \&quot;1\&quot; --&gt; \&quot;1\&quot; MovementEngine\n    Game \&quot;1\&quot; --&gt; \&quot;1\&quot; EyeBall\n    LevelManager \&quot;1\&quot; --&gt; \&quot;1\&quot; Board\n    LevelManager \&quot;1\&quot; --&gt; \&quot;1..*\&quot; GameLevel\n    Board \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Square\n    MovementEngine \&quot;1\&quot; --&gt; \&quot;1\&quot; IMoveStrategy\n    EyeBall \&quot;1\&quot; --&gt; \&quot;1\&quot; Position\n    Square &lt;|-- PlayableSquare\n    Square &lt;|-- BlankSquare\n    PlayableSquare ..&gt; IGoalHolder&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="aMaqATa8e-QqaU2_FBHq-16">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
                        <mxGeometry as="geometry"/>
