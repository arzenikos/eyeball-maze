<mxfile host="65bd71144e" pages="2">
    <diagram name="iteration-1" id="tuIKIHgPbcrpHOuQhni8">
        <mxGraphModel dx="4317" dy="3407" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% Enumerations\n    class Direction {\n        &lt;&lt;enumeration&gt;&gt;\n        UP\n        DOWN\n        LEFT\n        RIGHT\n    }\n\n    class Color {\n        &lt;&lt;enumeration&gt;&gt;\n        BLUE\n        RED\n        YELLOW\n        GREEN\n        BLANK\n        PURPLE\n    }\n\n    class Shape {\n        &lt;&lt;enumeration&gt;&gt;\n        DIAMOND\n        CROSS\n        STAR\n        FLOWER\n        BLANK\n        LIGHTNING\n    }\n\n    class Message {\n        &lt;&lt;enumeration&gt;&gt;\n        OK\n        DIFFERENT_SHAPE_OR_COLOR\n        BACKWARDS_MOVE\n        MOVING_OVER_BLANK\n        MOVING_DIAGONALLY\n    }\n\n    class ErrorCode {\n        &lt;&lt;enumeration&gt;&gt;\n        INDEX_OUT_OF_BOUNDS\n        SQUARE_NOT_FOUND\n        INVALID_MOVE\n    }\n\n    %% Core Classes &amp; Interfaces\n    class Game {\n        +squareCollection: Map~String, Square~\n        +levelCollection: List~GameLevel~\n        -levelCount: int\n        -theEyeball: EyeBall\n        -gameLevel: GameLevel\n        -LOGGER: Logger\n        +Game()\n        +addLevel(height: int, width: int): void\n        +getLevelWidth(): int\n        +getLevelHeight(): int\n        +getLevelCount(): int\n        +setLevel(newLevel: int): void\n        +addGoal(row: int, column: int): void\n        +getGoalCount(): int\n        +hasGoalAt(row: int, column: int): boolean\n        +getColorAt(row: int, column: int): Color\n        +getShapeAt(row: int, column: int): Shape\n        +addSquare(square: Square, row: int, column: int): void\n        +addEyeball(currentY: int, currentX: int, direction: Direction): void\n        +getEyeballRow(): int\n        +getEyeballColumn(): int\n        +getEyeballDirection(): Direction\n        +canMoveTo(row: int, column: int): boolean\n        +hasBlankFreePathTo(row: int, column: int): boolean\n        +isDirectionOK(newY: int, newX: int): boolean\n        +checkDirectionMessage(row: int, column: int): Message\n        +checkMessageForBlankOnPathTo(newY: int, newX: int): Message\n        +messageIfMovingTo(row: int, column: int): Message\n        +moveTo(row: int, column: int): void\n        +getCompletedGoalCount(): int\n        -isValidCoordinate(row: int, column: int): boolean\n        -getSquareAt(row: int, column: int): Square\n        -generateCoordinateKey(row: int, column: int): String\n        -isMatchingShapeOrColor(target: Square): boolean\n        -updateGoalSquare(): void\n    }\n\n    class GameLevel {\n        #levelNumber: int\n        #levelWidth: int\n        #levelHeight: int\n        +totalGoalCount: int\n        +completedGoalCount: int\n        +GameLevel(levelNumber: int, height: int, width: int)\n        +getLevelWidth(): int\n        +getLevelHeight(): int\n    }\n\n    class EyeBall {\n        #currentPosition: Position\n        #currentDirection: Direction\n        #currentYPosition: int\n        #currentXPosition: int\n        +EyeBall(newY: int, newX: int, direction: Direction)\n        +getXPosition(): int\n        +getYPosition(): int\n        +getDirection(): Direction\n        +updateEyeball(row: int, column: int): void\n        +getNewEyeballFacingDirection(targetY: int, targetX: int): Direction\n    }\n\n    class Position {\n        #row: int\n        #column: int\n        +Position(row: int, column: int)\n        +getRow(): int\n        +getColumn(): int\n    }\n\n    class Square {\n        &lt;&lt;abstract&gt;&gt;\n        +isGoal: boolean\n        #color: Color\n        #shape: Shape\n    }\n\n    class PlayableSquare {\n        +isGoal: boolean\n        +PlayableSquare()\n        +PlayableSquare(color: Color, shape: Shape)\n        +setAsGoal(): void\n    }\n\n    class BlankSquare {\n    }\n\n    %% Interfaces\n    class ILevelHolder {\n        &lt;&lt;interface&gt;&gt;\n        +addLevel(height: int, width: int): void\n        +getLevelWidth(): int\n        +getLevelHeight(): int\n        +setLevel(levelNumber: int): void\n        +getLevelCount(): int\n    }\n\n    class IGoalHolder {\n        &lt;&lt;interface&gt;&gt;\n        +addGoal(row: int, column: int): void\n        +getGoalCount(): int\n        +hasGoalAt(targetRow: int, targetColumn: int): boolean\n        +getCompletedGoalCount(): int\n    }\n\n    class IEyeballHolder {\n        &lt;&lt;interface&gt;&gt;\n        +addEyeball(row: int, column: int, direction: Direction): void\n        +getEyeballRow(): int\n        +getEyeballColumn(): int\n        +getEyeballDirection(): Direction\n    }\n\n    class IMoving {\n        &lt;&lt;interface&gt;&gt;\n        +canMoveTo(destinationRow: int, destinationColumn: int): boolean\n        +messageIfMovingTo(destinationRow: int, destinationColumn: int): Message\n        +isDirectionOK(destinationRow: int, destinationColumn: int): boolean\n        +checkDirectionMessage(destinationRow: int, destinationColumn: int): Message\n        +hasBlankFreePathTo(destinationRow: int, destinationColumn: int): boolean\n        +checkMessageForBlankOnPathTo(destinationRow: int, destinationColumn: int): Message\n        +moveTo(destinationRow: int, destinationColumn: int): void\n    }\n\n    %% Relationships\n    Game \&quot;1\&quot; --&gt; \&quot;1..*\&quot; GameLevel : contains\n    Game \&quot;1\&quot; --&gt; \&quot;0..1\&quot; EyeBall : has\n    GameLevel \&quot;1\&quot; --&gt; \&quot;1..*\&quot; Square : grid\n    EyeBall \&quot;1\&quot; --&gt; \&quot;1\&quot; Position : currentPosition\n    Square &lt;|-- PlayableSquare\n    Square &lt;|-- BlankSquare\n    PlayableSquare ..|&gt; IGoalHolder : implements (partial)\n\n    Game ..|&gt; ILevelHolder : implements\n    Game ..|&gt; IGoalHolder : implements\n    Game ..|&gt; IEyeballHolder : implements\n    Game ..|&gt; IMoving : implements\n\n    %% Note: Game implements most interfaces → heavy responsibility&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="5t0GwMmsOBza5HY_osz1-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
